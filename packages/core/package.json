{
  "name": "@byteplus-sdk/core",
  "version": "0.0.0",
  "description": "BytePlus Node.js SDK v2 — core engine (auth, signing, transport)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteplus-sdk/byteplus-node-sdk-v2.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/byteplus-sdk/byteplus-node-sdk-v2/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/byteplus-sdk/byteplus-node-sdk-v2/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  }
}
