{
  "name": "byteplus-sdk-v2-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "BytePlus Node.js SDK v2 (TypeScript port) — monorepo",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p examples/tsconfig.json",
    "test": "pnpm -r build && vitest run",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
